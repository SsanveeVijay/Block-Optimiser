// Sample source program demonstrating the full compiler pipeline
// Variable declarations, arithmetic, if/else, while loop

int a = 2 + 3;
int b = a * 4;
int i = 0;

while (i < 10) {
    int t = b + i;
    i = i + 1;
}

int x = 5;
int y = x + 1;

if (y > 3) {
    int z = y * 3;
} else {
    int z = y * 2;
}

int c = 10 / 3;
int d = c % 2;
return d;
